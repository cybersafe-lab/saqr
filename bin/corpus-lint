#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * Corpus drift guard. Validates corpus/frameworks.json:
 *  - schema: every entry has id, category (allowlisted), non-empty keywords, non-empty answer
 *  - id integrity: unique ids; no duplicate keywords within an entry; ids match corpus/ids.lock
 *  - keyword matchability: every keyword survives Retriever::normalize()
 *    unchanged. The scorer only ever sees a normalized question, so a keyword
 *    the pipeline would rewrite is dead weight that can never match again
 *  - prompt-injection blocklist on answer (SEC-007)
 *  - style: no em-dash or en-dash, no banned puff words (corpus/style-bans.txt)
 *  - display: every entry carries a non-empty title (the label clients show),
 *    and that title gets the same injection blocklist and style rules as the
 *    answer, since it reaches clients too
 *  - provenance: every entry carries a non-empty framework label
 *  - provenance: every non-META entry carries >=1 refs item, each {title: non-empty, url: https://...}
 *  - refs content: titles and urls are client-facing, so both get the answer's
 *    injection blocklist; the style rules run on titles only, since a URL is
 *    not ours to reword
 * Exit 0 clean, 1 on any violation.
 */

require __DIR__ . '/autoload.php';

$path = $argv[1] ?? __DIR__ . '/../corpus/frameworks.json';
$lockPath = __DIR__ . '/../corpus/ids.lock';

if (!is_file($path) || !is_readable($path)) {
    fwrite(STDERR, "corpus file not found or unreadable: {$path}\n");
    exit(1);
}

$data = json_decode((string) file_get_contents($path), true);

if ($data === null) {
    fwrite(STDERR, "corpus file is empty or not valid JSON: {$path}\n");
    exit(1);
}

$entries = $data['entries'] ?? [];

const ALLOWED_CATEGORIES = [
    'AUTHORITIES', 'NCA FRAMEWORKS', 'SAMA FRAMEWORKS',
    'CST / ARAMCO / PDPL', 'COMPARISONS', 'META',
];

$injectionBlocklist = [
    'ignore previous instructions', 'ignore the above', 'system:',
    '<source>', '</source>', '[SOURCE', 'disregard',
];

// Brand voice bans both long dashes: the em-dash as punctuation and the en-dash
// in ranges ("3-6 months"). Entities too, since answers ship as HTML.
const DASH_PATTERN = '/\x{2014}|\x{2013}|&mdash;|&ndash;/u';
const DASH_ADVICE = 'use commas, periods, parentheses, or "to" for a range';

$violations = 0;
$fail = static function (string $msg) use (&$violations): void {
    fwrite(STDERR, $msg . "\n");
    $violations++;
};

$banPath = __DIR__ . '/../corpus/style-bans.txt';
$bans = is_file($banPath)
    ? array_filter(array_map('trim', explode("\n", (string) file_get_contents($banPath))))
    : [];

$ids = [];
foreach ($entries as $i => $entry) {
    $id = $entry['id'] ?? null;
    if (!is_string($id) || $id === '') {
        $fail("Entry #{$i}: missing id");
        continue;
    }
    if (!preg_match('/^[a-z0-9-]+$/', $id)) {
        $fail("Entry '{$id}': id must match [a-z0-9-]+");
    }
    if (isset($ids[$id])) {
        $fail("Entry '{$id}': duplicate id");
    }
    $ids[$id] = true;

    $cat = $entry['category'] ?? null;
    if (!in_array($cat, ALLOWED_CATEGORIES, true)) {
        $fail("Entry '{$id}': category '" . (is_string($cat) ? $cat : 'null') . "' not in allowlist");
    }

    $kw = $entry['keywords'] ?? [];
    if (!is_array($kw) || $kw === []) {
        $fail("Entry '{$id}': empty keywords");
    } elseif (count($kw) !== count(array_unique($kw))) {
        $fail("Entry '{$id}': duplicate keywords");
    }
    // A question is normalized before it is scored, so a keyword the same
    // pipeline would rewrite can never be matched. Catches uppercase, Arabic
    // digits, dash variants, diacritics, and punctuation in a new keyword.
    foreach (is_array($kw) ? $kw : [] as $k) {
        if (!is_string($k)) {
            $fail("Entry '{$id}': keyword must be a string");
            continue;
        }
        $normalized = \Saqr\Retriever::normalize($k);
        if ($normalized !== $k) {
            $fail("Entry '{$id}': keyword '{$k}' is not in normalized form and can never match; write it as '{$normalized}'");
        }
    }

    $answer = $entry['answer'] ?? '';
    if (!is_string($answer) || trim($answer) === '') {
        $fail("Entry '{$id}': empty answer");
    }
    $hay = strtolower((string) $answer);
    foreach ($injectionBlocklist as $needle) {
        if (strpos($hay, strtolower($needle)) !== false) {
            $fail("Entry '{$id}': forbidden token: {$needle}");
        }
    }

    // Brand-voice style lint.
    if (preg_match(DASH_PATTERN, (string) $answer)) {
        $fail("Entry '{$id}': em-dash or en-dash in answer (" . DASH_ADVICE . ")");
    }
    foreach ($bans as $word) {
        if (preg_match('/\b' . preg_quote($word, '/') . '\b/i', (string) $answer)) {
            $fail("Entry '{$id}': banned puff word: {$word}");
        }
    }

    // Showcase sprint: title + framework label + official source refs.
    // The title is what an MCP client prints above the answer, so an entry
    // without one has no label a reader can recognize.
    $title = $entry['title'] ?? null;
    if (!is_string($title) || trim($title) === '') {
        $fail("Entry '{$id}': missing title");
    } else {
        // A title ships to clients next to the answer, so it carries the same
        // injection blocklist and the same style rules.
        foreach ($injectionBlocklist as $needle) {
            if (strpos(strtolower($title), strtolower($needle)) !== false) {
                $fail("Entry '{$id}': forbidden token in title: {$needle}");
            }
        }
        if (preg_match(DASH_PATTERN, $title)) {
            $fail("Entry '{$id}': em-dash or en-dash in title (" . DASH_ADVICE . ")");
        }
        foreach ($bans as $word) {
            if (preg_match('/\b' . preg_quote($word, '/') . '\b/i', $title)) {
                $fail("Entry '{$id}': banned puff word in title: {$word}");
            }
        }
    }

    $fw = $entry['framework'] ?? null;
    if (!is_string($fw) || trim($fw) === '') {
        $fail("Entry '{$id}': missing framework label");
    }

    $refs = $entry['refs'] ?? null;
    if (array_key_exists('refs', $entry) && !is_array($refs)) {
        // META is exempt from *needing* refs, not from the shape of the key.
        $fail("Entry '{$id}': refs must be an array");
    } elseif (($entry['category'] ?? '') !== 'META' && (!is_array($refs) || $refs === [])) {
        $fail("Entry '{$id}': missing refs (official source citations)");
    }
    foreach (is_array($refs) ? $refs : [] as $j => $ref) {
        if (!is_array($ref) || !isset($ref['title'], $ref['url'])
            || !is_string($ref['title']) || trim($ref['title']) === ''
            || !is_string($ref['url']) || !str_starts_with($ref['url'], 'https://')) {
            $fail("Entry '{$id}': refs[{$j}] must be {title: non-empty, url: https://...}");
            continue;
        }

        // Ref titles and urls are served to clients, so both carry the answer's
        // injection blocklist. The style rules below run on the title only: a
        // URL is the publisher's string, not ours to reword.
        foreach ($injectionBlocklist as $needle) {
            if (strpos(strtolower($ref['title']), strtolower($needle)) !== false) {
                $fail("Entry '{$id}': refs[{$j}] title: forbidden token: {$needle}");
            }
            if (strpos(strtolower($ref['url']), strtolower($needle)) !== false) {
                $fail("Entry '{$id}': refs[{$j}] url: forbidden token: {$needle}");
            }
        }
        if (preg_match(DASH_PATTERN, $ref['title'])) {
            $fail("Entry '{$id}': refs[{$j}] title: em-dash or en-dash (" . DASH_ADVICE . ")");
        }
        foreach ($bans as $word) {
            if (preg_match('/\b' . preg_quote($word, '/') . '\b/i', $ref['title'])) {
                $fail("Entry '{$id}': refs[{$j}] title: banned puff word: {$word}");
            }
        }
    }
}

// Frozen-ID lock: every id in ids.lock must still be present (when the lock exists).
// Only apply the lock check when linting the real production corpus — temp corpora
// used in tests do not contain production IDs and must not be tripped by this rule.
// The missing-file guard above ensures realpath() can never be false here for $path.
if (is_file($lockPath) && realpath($path) === realpath(__DIR__ . '/../corpus/frameworks.json')) {
    $locked = array_filter(array_map('trim', explode("\n", (string) file_get_contents($lockPath))));
    $current = array_keys($ids);
    sort($locked);
    sort($current);
    $missing = array_diff($locked, $current);
    foreach ($missing as $m) {
        $fail("Frozen id '{$m}' from ids.lock is missing; IDs are immutable. Add new ids to the lock, never rename.");
    }
}

exit($violations > 0 ? 1 : 0);
